RESEND_API_KEY=
# Where form submissions go. Stays on the developer's inbox until Resend verifies notimehub.com,
# then info@notimehub.com (D89, docs/launch/email-dns.md).
CONTACT_TO_EMAIL=
# Sender of the form auto-reply, on the verified domain, e.g. website@notimehub.com (D89).
MAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public origin. Empty in production = https://notimehub.com (src/config/site.ts, D90).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ENABLE_LAB=

# AI image generation, local scripts only (scripts/generate-image.mjs, D76). Never used by the site.
REPLICATE_API_TOKEN=
