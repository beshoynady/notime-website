# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# The review build (NEXT_PUBLIC_REVIEW_MODE=1, scripts/review.mjs)
/.next-review/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
test-results/
playwright-report/

# Heavy checkpoint artifacts (summaries and screenshots stay tracked). Scoped to
# docs/checkpoints so real site media (public/video, WebP images) is never ignored.
docs/checkpoints/lighthouse/**/raw/
docs/checkpoints/**/*.webm
docs/checkpoints/**/*.webp

# Raw company-profile extraction (scripts/extract-profile.mjs, D47): includes stock, AI and
# unapproved photos of people, so it never ships. Curated images go to public/images/work/<slug>/.
public/images/work/raw/

# AI image generation through an API (D76): originals, never committed
raw/

# Hand-generated AI images waiting for ingest (D79): originals, never committed
assets-inbox/

# Agent worktrees (D82)
.claude/worktrees/
.worktrees/
